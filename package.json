{
  "name": "tankstorm-classic",
  "version": "0.25.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node native/dev.mjs",
    "build": "node native/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "node native/start.mjs",
    "format": "prettier --write src tests vite.config.ts tsconfig.json package.json",
    "check": "tsc -b && prettier --check src tests native/rules native/*.mjs vite.config.ts",
    "test:report": "vitest run --reporter=json --outputFile=artifacts/test-results.json",
    "build:native": "node native/build.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "tsc -b && vite build",
    "preview:web": "vite preview --host 127.0.0.1",
    "start": "node native/start.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^4.1.11",
    "esbuild": "0.25.12"
  },
  "engines": {
    "node": ">=22.12"
  }
}
